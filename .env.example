# Copy to .env for local compose overrides. Never commit real secrets.

POSTGRES_PASSWORD=change-me-local-only
# Production bundled Postgres (hostname `postgres` is the Compose service).
# Password after archive: must match POSTGRES_PASSWORD.
# DATABASE_URL=postgres://archive:change-me-local-only@postgres:5432/archive
# REQUIRE_DB_TLS=false
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=change-me-session-secret-min-32-chars
RECOVERY_SECRET=change-me-recovery-secret-local-only
INSTANCE_NAME=logscale-archive-local
APP_BIND=127.0.0.1
APP_PORT=8080
# Web-app timestamp display and date/time input interpretation.
DISPLAY_TIMEZONE=UTC
# HTTP first-install: SECURE_COOKIES=false (login cookie). HTTPS/NGINX: true.
# SECURE_COOKIES=false
# Direct LogScale operations logging: also start with -f infra/compose.logging.yaml.
# LOG_LEVEL=info
# LOGSCALE_LOG_ENDPOINT=https://logs.example
# Maximum events requested per event-archive query. The collector appends tail() automatically.
LOGSCALE_EVENT_TAIL_LIMIT=1000
