# Copy to .env for local compose overrides. Never commit real secrets.

POSTGRES_PASSWORD=change-me-local-only
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=change-me-session-secret-min-32-chars
RECOVERY_SECRET=change-me-recovery-secret-local-only
APP_BIND=127.0.0.1
APP_PORT=8080
# SECURE_COOKIES=true forces Secure cookies when not binding localhost
